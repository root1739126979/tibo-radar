{
  "name": "tibo-radar",
  "version": "1.0.0",
  "private": true,
  "description": "Cloud Tibo reset-signal monitoring plus local Codex weekly quota tracking.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "test:windows-task": "powershell -NoProfile -ExecutionPolicy Bypass -File ./test/scheduled-task-hidden.test.ps1",
    "test:manual-status": "powershell -NoProfile -ExecutionPolicy Bypass -File ./test/manual-status-entry.test.ps1",
    "status": "node src/status.js",
    "sample": "node src/sample.js",
    "doctor": "node src/doctor.js",
    "cloud:dry-run": "node src/cloud-monitor.js --dry-run"
  }
}
